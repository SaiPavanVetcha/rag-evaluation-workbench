# RAG-Bench Frontend Environment Variables
# In production (e.g., Vercel), set VITE_API_URL to your deployed backend URL:
# Example: VITE_API_URL=https://rag-bench-backend.onrender.com
# In local development, you can point to http://127.0.0.1:8000 or leave it empty to use the Vite proxy.
VITE_API_URL=http://127.0.0.1:8000
